<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WcsGateway</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="appsettings.Local.json" />
    <None Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <PackageReference Include="FluentModbus" Version="5.3.2" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="S7netplus" Version="0.20.0" />
  </ItemGroup>
</Project>
